    {
      "name": "03 - Contracts & Customer Rentals",
      "item": [
        {
          "name": "03.1 - List Customer Contracts",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Returns customer contracts\", function () {",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data).to.be.an(\"array\");",
                  "});",
                  "if (Array.isArray(jsonData.data) && jsonData.data.length > 0) {",
                  "    var preferredFacility = pm.variables.get(\"facility_code\");",
                  "    var isActive = function (c) { return c && (c.status === \"ACTIVE\" || c.status === \"EXPIRING_SOON\"); };",
                  "    var matchFacility = function (c) {",
                  "        var code = c && (c.facilityCode || (c.facility && c.facility.code));",
                  "        return !preferredFacility || code === preferredFacility;",
                  "    };",
                  "    var chosen = jsonData.data.find(function (c) { return isActive(c) && matchFacility(c); })",
                  "        || jsonData.data.find(isActive)",
                  "        || jsonData.data[0];",
                  "    if (chosen && chosen.id) {",
                  "        pm.collectionVariables.set(\"contract_id\", chosen.id);",
                  "    }",
                  "    var chosenFacility = chosen && (chosen.facilityCode || (chosen.facility && chosen.facility.code));",
                  "    if (chosenFacility) {",
                  "        pm.collectionVariables.set(\"facility_code\", chosenFacility);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customer_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/contracts",
              "host": ["{{baseUrl}}"],
              "path": ["contracts"]
            }
          }
        },
        {
          "name": "03.2 - Get Specific Contract ({{contract_id}})",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Contract ID matches\", function () {",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    var returnedId = (jsonData.data && jsonData.data.contract && jsonData.data.contract.id) || (jsonData.data && jsonData.data.id);",
                  "    pm.expect(returnedId).to.eql(pm.variables.get(\"contract_id\"));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customer_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/contracts/{{contract_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["contracts", "{{contract_id}}"]
            }
          }
        }
      ]
