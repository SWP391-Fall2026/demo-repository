      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const raw = pm.variables.get(\"test_password\") || await pm.vault.get(\"storage-rental-auth-test-password\");",
              "if (!raw || raw === raw.trim()) throw new Error(\"AUTH-PWD-04 requires a fixture with edge spaces.\");",
              "pm.variables.set(\"auth_request_body\", JSON.stringify({username: pm.variables.get(\"test_username\"), password: raw.trim()}));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Trimmed variant is a different credential\", () => {",
              " pm.response.to.have.status(401);",
              " pm.expect(pm.response.json().success).to.eql(false);",
              " pm.expect(pm.response.json()).not.to.have.property(\"token\");",
              "});"
            ]
          }
        }
      ]
    },
