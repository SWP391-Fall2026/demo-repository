{
  "name": "storage-rental",
  "private": true,
  "version": "2.0.0",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "test:frontend": "npm run test --workspace frontend",
    "test:backend": "mvn -f backend/pom.xml test",
    "start:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-backend.ps1 -Profile auth-supabase",
    "check": "npm run build && npm run test:frontend && npm run check:contract",
    "check:contract": "node scripts/check-contract.mjs",
    "start:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-backend.ps1 -Profile local"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-java": "^2.11.0"
  }
}
