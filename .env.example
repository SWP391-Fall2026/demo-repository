# CẤU HÌNH SERVER
PORT=3000

# CẤU HÌNH KẾT NỐI SUPABASE (SUPABASE DATABASE & AUTH)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Spring Boot JPA cần Database Password để kết nối PostgreSQL.
# Dùng Session Pooler trong SUPABASE_DB_URL nếu direct database timeout.
# Pooler user có dạng postgres.<project-ref>.
SUPABASE_DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=your-database-password

# TÀI KHOẢN HỆ THỐNG:
# Customer: customer / 1
# System Administrator: admin / 2
# Staff: staff / 3
# Facility Manager: manager / 4
# Business Operations Manager: business / 5
